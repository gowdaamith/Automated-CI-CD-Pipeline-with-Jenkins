pipeline {

    agent any

    environment {
        DOCKER_IMAGE = 'gowdaamith/cicd-demo'
        DOCKER_CREDENTIALS = 'docker-cred'
        EC2_SSH_CREDENTIALS = 'staging-ec2-ssh'
    }

    stages {

        stage('CHECKOUT') {
            steps {
                checkout scm
            }
        }

        stage('COMPILE') {
            steps {
                dir('application') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Unit test') {
            steps {
                dir('application') {
                    sh 'mvn test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('application') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        stage('Package') {
            steps {
                dir('application') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('application') {
                    withMaven(
                        globalMavenSettingsConfig: 'settings.xml',
                        traceability: true
                    ) {
                        sh 'mvn deploy'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('application') {
                    sh '''
                        docker build -t "$DOCKER_IMAGE:${BUILD_NUMBER}" .
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | \
                            docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push "$DOCKER_IMAGE:${BUILD_NUMBER}"

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                sshagent(["${EC2_SSH_CREDENTIALS}"]) {
                    sh '''
                        ansible-playbook \
                            -i ansible/inventory.ini \
                            ansible/playbook.yml \
                            --extra-vars "docker_image=${DOCKER_IMAGE}:${BUILD_NUMBER}"
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                sshagent(["${EC2_SSH_CREDENTIALS}"]) {
                    sh '''
                        ansible-playbook \
                            -i ansible/inventory.ini \
                            ansible/health-check.yml
                    '''
                }
            }
        }

        stage('Production Approval') {
            steps {
                input(
                    message: """Staging deployment completed successfully.

Health check passed.

Docker image:
${DOCKER_IMAGE}:${BUILD_NUMBER}

Do you want to deploy this version to Production?""",
                    ok: 'Approve Production Deployment'
                )
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Deploying to Production'
            }
        }
    }

    post {
        success {
            echo ' PIPELINE SUCCESS '
        }

        failure {
            echo ' PIPELINE FAILED '
        }

        aborted {
            echo ' PIPELINE ABORTED'
        }
    }
}

