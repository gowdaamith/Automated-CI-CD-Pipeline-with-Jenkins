pipeline{
    agent any
    stages{
        stage('checkout'){
            steps{
                checkout scm
            }
        }
        stage('compile'){
            steps{
                sh '''
                    cd application
                    mvn clean compile
                '''
            }
        }
        stage('Test'){
            steps{
                sh '''
                    cd application
                    mvn test
                '''
            }
        }
        stage('Sonarqube Analysis'){
            steps{
                withSonarQubeEnv('SonarQube'){
                    sh '''
                        cd application
                        mvn sonar:sonar
                    '''
                }
            }
         }
         stage('Package'){
             steps{
                 sh '''
                   cd application
                   mvn package -DskipTests
                 ''' 
             }
         }
         stage('Quality Gate'){
             steps{
                 timeout(time: 5,unit: 'MINUTES'){
                     waitForQualityGate abortPipeline: true
                 }
             }
         }
    }
    post{ 
        success{
            echo " ci pipeline completed successfully "
        }
        failure{
            echo " ci pipeline failed"
        }
        always{
            echo " Pipeline execution completed"
        }
    }
}

