```groovy
pipeline {

    agent any

    environment {
        DOCKER_IMAGE = 'gowdaamith/cicd-demo'
        DOCKER_CREDENTIALS = 'docker-cred'
        EC2_SSH_CREDENTIALS = 'staging-ec2-ssh'
    }

    stages {

        stage('CHECKOUT') {
            steps {
                checkout scm
            }
        }

        stage('COMPILE') {
            steps {
                dir('application') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('UNIT TEST') {
            steps {
                dir('application') {
                    sh 'mvn test'
                }
            }
        }

        stage('SONARQUBE ANALYSIS') {
            steps {
                dir('application') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('PACKAGE') {
            steps {
                dir('application') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('PUBLISH TO NEXUS') {
            steps {
                dir('application') {
                    withMaven(
                        globalMavenSettingsConfig: 'settings.xml',
                        traceability: true
                    ) {
                        sh 'mvn deploy'
                    }
                }
            }
        }

        stage('DOCKER BUILD') {
            steps {
                dir('application') {
                    sh '''
                        docker build \
                            -t "${DOCKER_IMAGE}:${BUILD_NUMBER}" \
                            .
                    '''
                }
            }
        }

        stage('DOCKER PUSH') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | \
                            docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push "${DOCKER_IMAGE}:${BUILD_NUMBER}"

                        docker logout
                    '''
                }
            }
        }

        stage('DEPLOY TO STAGING') {
            steps {
                sshagent(["${EC2_SSH_CREDENTIALS}"]) {
                    sh '''
                        ansible-playbook \
                            -i ansible/inventory.ini \
                            ansible/playbook.yml \
                            --extra-vars "docker_image=${DOCKER_IMAGE}:${BUILD_NUMBER}"
                    '''
                }
            }
        }

        stage('HEALTH CHECK') {
            steps {
                sshagent(["${EC2_SSH_CREDENTIALS}"]) {
                    sh '''
                        ansible-playbook \
                            -i ansible/inventory.ini \
                            ansible/health-check.yml
                    '''
                }
            }
        }

        stage('PRODUCTION APPROVAL') {
            steps {
                input(
                    message: """Staging deployment completed successfully.

Health check passed.

Docker image:
${DOCKER_IMAGE}:${BUILD_NUMBER}

Do you want to deploy this version to Production?""",
                    ok: 'Approve Production Deployment'
                )
            }
        }

        stage('DEPLOY TO PRODUCTION') {
            steps {
                echo 'Deploying to Production'
            }
        }
    }

    post {

        success {
            echo 'PIPELINE SUCCESS'
        }

        failure {
            echo 'PIPELINE FAILED'
        }

        aborted {
            echo 'PIPELINE ABORTED'
        }
    }
}
```

